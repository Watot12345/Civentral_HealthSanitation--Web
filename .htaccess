<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -MultiViews

    # 1. Serve existing physical files (CSS, JS, images) and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Silently route extension-less URLs to target .php files
    RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI}.php -f [OR]
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>